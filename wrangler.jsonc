{
	"compatibility_date": "2026-05-29",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "devkage-space",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Astro Sessions store. Bind the existing namespace by id so deploys
	// don't try to auto-provision (re-create) it on every build.
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "8810f189978742beb61e3b4f393d83cc" }
	],
	"observability": {
		"enabled": true
	}
}