---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { tagLabel } from '../../lib/tags';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const fmtFull = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`${post.data.title} — devkage`} description={post.data.excerpt}>
  <article class="px-5 sm:px-6 py-6 sm:py-8">
    <a
      href="/"
      class="inline-block mb-4 font-mono text-[11px] text-[color:var(--color-text-tertiary)] no-underline hover:text-[color:var(--color-accent)]"
    >
      ← all posts
    </a>

    <header class="mb-6 border-b border-[color:var(--color-border-tertiary)] pb-5">
      <h1
        class="font-display text-2xl sm:text-3xl font-bold leading-tight tracking-tight text-[color:var(--color-text-primary)]"
      >
        {post.data.title}
      </h1>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <time
          datetime={post.data.date.toISOString()}
          class="font-mono text-[11px] text-[color:var(--color-text-tertiary)]"
        >
          {fmtFull}
        </time>
        <div class="flex flex-wrap gap-1.5">
          {post.data.tags.map((t) => (
            <span class={`ptag ptag-${t}`}>{tagLabel[t]}</span>
          ))}
        </div>
      </div>
    </header>

    <div class="prose-post">
      <Content />
    </div>

    <footer
      class="mt-10 border-t border-[color:var(--color-border-tertiary)] pt-5 text-sm text-[color:var(--color-text-secondary)]"
    >
      <p>
        Thanks for reading. Reply at
        <a href="/contact" class="text-[color:var(--color-accent)] underline underline-offset-2">
          /contact
        </a>
        — I read everything.
      </p>
    </footer>
  </article>
</Layout>
