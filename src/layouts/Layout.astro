---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter share image, resolved relative to the site origin. */
  image?: string;
  /** Present on blog posts; switches og:type to "article" + adds BlogPosting JSON-LD. */
  article?: {
    headline: string;
    publishedTime: string;
    tags?: string[];
  };
}

const {
  title = 'devkage · HPC, AI & C++',
  description = 'A personal blog by Bonaventura on HPC, AI, C++, and life as an MSc Computer Science student at the University of York.',
  image = '/og/default.jpg',
  article,
} = Astro.props;

const site = Astro.site ?? new URL('https://devkage.space');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

// Stable @id so WebSite/BlogPosting can reference one canonical Person entity.
const personId = `${new URL('/about', site).href}#person`;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Bonaventura',
  alternateName: 'Bona',
  url: new URL('/about', site).href,
  sameAs: ['https://github.com/bonskki', 'https://www.linkedin.com/in/bonabon/'],
};

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'devkage',
    url: site.href,
    description:
      'A personal blog by Bonaventura on HPC, AI, C++, and software engineering.',
    author: { '@id': personId },
  },
  { '@context': 'https://schema.org', ...person },
];

if (article) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: article.headline,
    description,
    image: ogImage,
    datePublished: article.publishedTime,
    author: { '@id': personId },
    publisher: { '@id': personId },
    mainEntityOfPage: canonical,
    ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Bonaventura" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="devkage"
      href="/rss.xml"
    />

    <meta property="og:site_name" content="devkage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,700;1,9..144,300&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body class="min-h-screen bg-[color:var(--color-bg-secondary)]">
    <main class="mx-auto max-w-2xl px-0 sm:px-4 py-0 sm:py-8">
      <div
        class="bg-[color:var(--color-bg-primary)] sm:border sm:border-[color:var(--color-border-tertiary)] sm:rounded-xl overflow-hidden"
      >
        <Nav />
        <slot />
      </div>
      <footer class="px-5 sm:px-6 py-6 text-center font-mono text-[10px] uppercase tracking-wider text-[color:var(--color-text-tertiary)]">
        devkage.space · made with care in jakarta
      </footer>
    </main>
  </body>
</html>
