---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

const links = [
  { href: '/', label: 'posts' },
  { href: '/about', label: 'about' },
  { href: '/contact', label: 'contact' },
];
---

<nav class="flex items-center justify-between px-5 sm:px-6 py-3.5 border-b border-[color:var(--color-border-tertiary)]">
  <a href="/" class="font-mono text-sm text-[color:var(--color-text-primary)] no-underline">
    devkage
  </a>
  <div class="flex items-center gap-4 sm:gap-5">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={[
          'text-xs font-medium no-underline transition-colors',
          isActive(l.href)
            ? 'text-[color:var(--color-accent-deep)]'
            : 'text-[color:var(--color-text-secondary)] hover:text-[color:var(--color-accent)]',
        ]}
      >
        {l.label}
      </a>
    ))}
  </div>
</nav>
